{
	"schemaVersion": 1,
	"id": "qommons",
	"version": "${version}",
	"name": "Qommons",
	"description": "Common utilities for qorg mods.",
	"authors": [
		"Lugo_Sieben"
	],
	"contact": {
		"homepage": "https://github.com/lugosieben/qorg-mods",
		"sources": "https://github.com/lugosieben/qorg-mods",
		"issues": "https://github.com/lugosieben/qorg-mods/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"qorg.qommons.Qommons"
		],
		"modmenu": [
			"qorg.qommons.integration.ModMenuIntegration"
		]
	},
	"suggests": {
		"modmenu": "*"
	},
	"depends": {
		"fabricloader": "${loader_compatible}",
		"minecraft": "${minecraft_version_compatible}",
		"java": "${java_compatible}",
		"fabric-api": "${fabric_api_compatible}"
	}
}
